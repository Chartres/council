# The LLM gateway Worker that runs the council (never an Anthropic key in the client).
# Dev/CI: `npm run stub` then VITE_GATEWAY_URL=http://localhost:8787
VITE_GATEWAY_URL=https://llm.dravec.org

# Optional — enables magic-link sign-in and "My ideas" persistence.
# Without these the app works anonymously with localStorage-only history.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
